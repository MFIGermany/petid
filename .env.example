# Aplicação
PORT=3002
APP_URL=http://localhost:3002
NODE_ENV=development
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
SESSION_COOKIE_NAME=petid.sid
SESSION_MAX_AGE_MS=7200000

# PostgreSQL / Supabase Database
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Supabase Storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=pet-photos

# Painel administrativo
ADMIN_NAME=Administrador PetID
ADMIN_EMAIL=admin@seudominio.com
# Recomendado: gerar com `npm run admin:hash -- "sua-senha-forte"`
ADMIN_PASSWORD_HASH=
# Fallback opcional para primeiro teste. Não use junto com HASH em produção.
ADMIN_PASSWORD=
