<%- include('../common/head', { title }) %>
<div class="login-wrap">
  <div class="container">
    <section class="card login-card" style="margin:auto">
      <div class="logo-center">
        <span class="brand-mark">🐾</span>
        <h2 style="margin:14px 0 6px">Que bom ter você de volta</h2>
        <p class="muted">Gerencie seus pets e suas plaquinhas.</p>
      </div>
      <% if (error) { %>
      <div class="flash flash-error"><%= error %></div>
      <% } %>
      <form method="post" action="/login">
        <div class="field">
          <label>E-mail</label>
          <input name="email" type="email" required autocomplete="email">
        </div>
        <div class="field" style="margin-top:14px">
          <label>Senha</label>
          <input name="password" type="password" required autocomplete="current-password">
        </div>
        <button class="btn btn-primary" style="width:100%;margin-top:20px">Entrar</button>
      </form>
      <div class="divider">ou</div>
      <p class="muted" style="text-align:center">Ainda não tem uma conta? <a href="/register" style="color:var(--primary);font-weight:800">Criar conta</a></p>
    </section>
  </div>
</div>
<%- include('../common/footer') %>
