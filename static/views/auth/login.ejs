<%- include('../common/head', { title }) %>
<div class="login-wrap"><div class="container"><section class="card login-card" style="margin:auto">
  <div class="logo-center"><span class="brand-mark">🐾</span><h2 style="margin:14px 0 6px">Bienvenido de vuelta</h2><p class="muted">Administra tus mascotas y chapitas.</p></div>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <div class="field"><label>Correo electrónico</label><input name="email" type="email" required autocomplete="email"></div>
    <div class="field" style="margin-top:14px"><label>Contraseña</label><input name="password" type="password" required autocomplete="current-password"></div>
    <button class="btn btn-primary" style="width:100%;margin-top:20px">Entrar</button>
  </form>
  <div class="divider">o</div>
  <p class="muted" style="text-align:center">¿Aún no tienes cuenta? <a href="/register" style="color:var(--primary);font-weight:800">Crear cuenta</a></p>
</section></div></div>
<%- include('../common/footer') %>