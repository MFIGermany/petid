<!DOCTYPE html>
<html>
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content=""/>
	<meta name="keywords" content="" />
	<title>Serviço de Identificação Digital de Animais de Estimação</title>
	<link href="<%= data.baseUrl %>/img/favico.png" rel="shortcut icon" type="image/ico" />
	
	<link href="<%= data.baseUrl %>/css/petid.css" rel="stylesheet" type="text/css" />
	<script type="text/javascript" src="<%= data.baseUrl %>/js/jquery.js"></script>
</head>
<header class="topbar">
    <div class="container nav">
        <a class="brand" href="/">
            <span class="brand-mark">🐾</span>
            PetID
        </a>

        <div class="nav-actions">

            <% if (data.currentUser) { %>
				<a class="btn btn-light" href="/dashboard">
                    Ir a mis mascotas
                </a>
                <a class="btn btn-light" href="/tags/activate">
                    Activar chapita
                </a>

                <form action="/logout" method="POST" style="margin:0;">
                    <button type="submit" class="btn btn-light">
                        Salir
                    </button>
                </form>

            <% } else { %>

                <a class="btn btn-light" href="/login">
                    Entrar
                </a>

            <% } %>

        </div>
    </div>
</header>