<%- include('common/head', { title }) %>
<section class="page">
  <div class="container grid grid-2">
  <section class="card hero-card">
    <span class="eyebrow">Identificação inteligente</span>
    <h1>Uma plaquinha. Uma história. Um caminho de volta para casa.</h1>
    <p class="lead">O PetID conecta uma plaquinha NFC a um perfil digital atualizável, para que qualquer pessoa possa identificar seu pet e entrar em contato com você rapidamente.</p>
    <div class="nav-actions" style="margin-top:24px">
      <% if (data.currentUser) { %>
        <a class="btn btn-primary" href="/dashboard">Meus pets</a>
        <a class="btn btn-light" href="/tags/activate">Ativar plaquinha</a>
      <% } else { %>
        <a class="btn btn-primary" href="/register">Começar</a>
        <a class="btn btn-light" href="/p/DEMO123">Ver exemplo</a>
      <% } %>
    </div>
  </section>
  <section class="card">
    <div class="tag-preview"><div><div style="font-size:42px">🐾</div><strong>TOBBY</strong><small>Aproxime seu celular</small></div></div>
    <ul class="check-list" style="margin-top:26px">
      <li><span class="check">✓</span><div><strong>Tag NFC</strong><div class="muted">Uma forma rápida de abrir o perfil do seu pet.</div></div></li>
      <li><span class="check">✓</span><div><strong>Dados atualizáveis</strong><div class="muted">Atualize os contatos sem precisar trocar a plaquinha.</div></div></li>
      <li><span class="check">✓</span><div><strong>Modo perdido</strong><div class="muted">Destaque as informações mais importantes quando elas forem mais necessárias.</div></div></li>
    </ul>
  </section>
</div>
</section>
<%- include('common/footer') %>
