<%- include('../common/head', { title }) %>
<section class="page"><div class="container"><div style="max-width:820px;margin:auto">
  <div style="margin-bottom:22px">
    <span class="eyebrow">Perfil de mascota</span>
    <h1 style="margin-top:10px"><%= pet && pet.id ? `Datos de ${pet.name}` : 'Nueva mascota' %></h1>
    <p class="muted">Estos datos forman el perfil que podrá abrirse desde NFC o QR.</p>
  </div>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <form
    class="card"
    method="post"
    enctype="multipart/form-data"
    action="<%= pet && pet.id ? `/pets/${pet.id}` : '/pets' %>"
  >
    <div class="form-grid">
      <div class="field full">
        <label>Foto de la mascota</label>

        <% if (pet?.photo_url) { %>
          <div style="margin:4px 0 14px">
            <img
              src="<%= pet.photo_url %>"
              alt="Foto de <%= pet.name || 'la mascota' %>"
              style="width:130px;height:130px;object-fit:cover;border-radius:24px;border:1px solid var(--border)"
            >
          </div>
        <% } %>

        <input
          name="photo"
          type="file"
          accept="image/jpeg,image/png,image/webp"
        >
        <div class="helper">
          JPG, PNG o WEBP · máximo 5 MB.
          <%= pet?.photo_url ? 'Si no seleccionas una nueva imagen, se conserva la actual.' : '' %>
        </div>
      </div>

      <div class="field"><label>Nombre *</label><input name="name" required value="<%= pet?.name || '' %>"></div>
      <div class="field"><label>Especie *</label><select name="species" required>
        <% ['Perro','Gato','Otra'].forEach(v => { %><option value="<%= v %>" <%= pet?.species===v ? 'selected' : '' %>><%= v %></option><% }) %>
      </select></div>
      <div class="field"><label>Raza</label><input name="breed" value="<%= pet?.breed || '' %>"></div>
      <div class="field"><label>Sexo</label><select name="sex"><option value="">Seleccionar</option><% ['Macho','Hembra'].forEach(v => { %><option value="<%= v %>" <%= pet?.sex===v ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
      <div class="field"><label>Fecha de nacimiento</label><input name="birth_date" type="date" value="<%= pet?.birth_date ? new Date(pet.birth_date).toISOString().slice(0,10) : '' %>"></div>
      <div class="field"><label>Color</label><input name="color" value="<%= pet?.color || '' %>"></div>
      <div class="field full"><label>Condiciones médicas / alergias</label><textarea name="medical_conditions"><%= pet?.medical_conditions || '' %></textarea></div>
      <div class="field full"><label>Información útil para quien lo encuentre</label><textarea name="notes"><%= pet?.notes || '' %></textarea></div>
    </div>

    <hr style="border:0;border-top:1px solid var(--border);margin:24px 0">
    <h2>Contacto principal</h2>
    <div class="form-grid">
      <div class="field"><label>Nombre</label><input name="contact_name" value="<%= contact?.name || formUserName || data?.currentUser?.name || '' %>"></div>
      <div class="field"><label>Relación</label><input name="relationship" value="<%= contact?.relationship || 'Tutor' %>"></div>
      <div class="field"><label>Teléfono</label><input name="phone" value="<%= contact?.phone || '' %>"></div>
      <div class="field"><label>WhatsApp</label><input name="whatsapp" value="<%= contact?.whatsapp || contact?.phone || '' %>"></div>
    </div>

    <div class="nav-actions" style="justify-content:flex-end;margin-top:26px">
      <a class="btn btn-light" href="/dashboard">Cancelar</a>
      <button class="btn btn-primary" type="submit">Guardar cambios</button>
    </div>
  </form>

  <% if (pet && pet.id) { %>
    <section class="card" style="margin-top:22px">
      <h2>Chapitas vinculadas</h2>
      <% if (!tags.length) { %><p class="muted">Todavía no hay chapitas vinculadas.</p><% } %>
      <% tags.forEach(tag => { %>
        <div class="info-row"><span>PetID</span><strong><%= tag.public_code ? tag.public_code : 'Sin activar' %></strong></div>
        <% if (tag.public_code) { %><div style="margin-top:10px"><a class="btn btn-light" href="/p/<%= tag.public_code %>" target="_blank">Ver perfil público</a></div><% } %>
      <% }) %>
      <div style="margin-top:18px"><a class="btn btn-primary" href="/tags/activate">Activar una chapita</a></div>
    </section>

    <section style="margin-top:22px">
      <form method="post" action="/pets/<%= pet.id %>/delete" data-confirm="¿Seguro que deseas eliminar esta mascota?">
        <button class="btn btn-danger" type="submit">Eliminar mascota</button>
      </form>
    </section>
  <% } %>
</div></div></section>
<%- include('../common/footer') %>
