<%- include('../common/head', { title }) %>
<section class="page">
  <div class="container">
    <div style="max-width:820px;margin:auto">
      <div style="margin-bottom:22px">
        <span class="eyebrow">Perfil do pet</span>
        <h1 style="margin-top:10px"><%= pet && pet.id ? `Dados de ${pet.name}` : 'Novo pet' %></h1>
        <p class="muted">Esses dados formam o perfil que poderá ser aberto por NFC ou link.</p>
      </div>
      <% if (error) { %>
      <div class="flash flash-error"><%= error %></div>
      <% } %>
      <form class="card" method="post" enctype="multipart/form-data" action="<%= pet && pet.id ? `/pets/${pet.id}` : '/pets' %>">
        <div class="form-grid">
          <div class="field full">
            <label>Foto do pet</label>
            <% if (pet?.photo_url) { %>
              <div style="margin:4px 0 14px">
                <img src="<%= pet.photo_url %>" alt="Foto de <%= pet.name || 'seu pet' %>" style="width:130px;height:130px;object-fit:cover;border-radius:24px;border:1px solid var(--border)">
              </div>
            <% } %>
            <input name="photo" type="file" accept="image/jpeg,image/png,image/webp">
            <div class="helper">
              JPG, PNG ou WEBP · máximo de 5 MB.
              <%= pet?.photo_url ? 'Se você não selecionar uma nova imagem, a foto atual será mantida.' : '' %>
            </div>
          </div>
          <div class="field">
            <label>Nome *</label>
            <input name="name" required value="<%= pet?.name || '' %>">
          </div>
          <div class="field">
            <label>Espécie *</label>
            <select name="species" required>
              <option value="Cachorro" <%= ['Cachorro','Perro'].includes(pet?.species) ? 'selected' : '' %>>Cão</option>
              <option value="Gato" <%= pet?.species === 'Gato' ? 'selected' : '' %>>Gato</option>
              <option value="Outro" <%= ['Outro','Outra','Otro'].includes(pet?.species) ? 'selected' : '' %>>Outro</option>
            </select>
          </div>
          <div class="field">
            <label>Raça</label>
            <input name="breed" value="<%= pet?.breed || '' %>">
          </div>
          <div class="field">
            <label>Sexo</label>
            <select name="sex">
              <option value="">Selecionar</option>
              <option value="Macho" <%= pet?.sex === 'Macho' ? 'selected' : '' %>>Macho</option>
              <option value="Fêmea" <%= ['Fêmea','Hembra'].includes(pet?.sex) ? 'selected' : '' %>>Fêmea</option>
            </select>
          </div>
          <div class="field">
            <label>Data de nascimento</label>
            <input name="birth_date" type="date" value="<%= pet?.birth_date ? new Date(pet.birth_date).toISOString().slice(0,10) : '' %>">
          </div>
          <div class="field">
            <label>Cor</label>
            <input name="color" value="<%= pet?.color || '' %>">
          </div>
          <div class="field full">
            <label>Condições médicas / alergias</label>
            <textarea name="medical_conditions"><%= pet?.medical_conditions || '' %></textarea>
          </div>
          <div class="field full">
            <label>Informações úteis para quem encontrar o pet</label>
            <textarea name="notes"><%= pet?.notes || '' %></textarea>
          </div>
        </div>
        <hr style="border:0;border-top:1px solid var(--border);margin:24px 0">
        <h2>Contato principal</h2>
        <div class="form-grid">
          <div class="field">
            <label>Nome</label>
            <input name="contact_name" value="<%= contact?.name || formUserName || data?.currentUser?.name || '' %>">
          </div>
          <div class="field">
            <label>Relação</label>
            <input name="relationship" value="<%= contact?.relationship || 'Tutor' %>">
          </div>
          <div class="field">
            <label>Telefone</label>
            <input name="phone" value="<%= contact?.phone || '' %>">
          </div>
          <div class="field">
            <label>WhatsApp</label>
            <input name="whatsapp" value="<%= contact?.whatsapp || contact?.phone || '' %>">
          </div>
        </div>
        <div class="nav-actions" style="justify-content:flex-end;margin-top:26px">
          <a class="btn btn-light" href="/dashboard">Cancelar</a>
          <button class="btn btn-primary" type="submit">Salvar alterações</button>
        </div>
      </form>
      <% if (pet && pet.id) { %>
      <section class="card" style="margin-top:22px">
        <h2>Plaquinhas vinculadas</h2>
        <% if (!tags.length) { %>
        <p class="muted">Ainda não há plaquinhas vinculadas.</p>
        <% } %>
        <% tags.forEach(tag => { %>
        <div class="tag-list-item">
          <div class="tag-list-main">
            <div>
              <div class="muted" style="font-size:.82rem;margin-bottom:4px">PetID:
                <strong class="code"><%= tag.public_code ? tag.public_code : 'Sem código público' %></strong>
              </div>
            </div>
            <span class="status <%= tag.status === 'active' ? 'status-tag-active' : 'status-tag-inactive' %>">
              <%= tag.status === 'active' ? 'Ativa' : 'Inativa' %>
            </span>
          </div>
          <% if (tag.status === 'active' && tag.public_code) { %>
          <div style="margin-top:14px">
            <a class="btn btn-light" href="/p/<%= tag.public_code %>" target="_blank" rel="noopener noreferrer">Ver perfil público</a>
          </div>
          <% } %>
        </div>
        <% }) %>
        <div style="margin-top:18px">
          <a class="btn btn-primary" href="/tags/activate">Ativar uma plaquinha</a>
        </div>
      </section>
      <section style="margin-top:22px">
        <form method="post" action="/pets/<%= pet.id %>/delete" data-confirm="Tem certeza de que deseja excluir este pet?">
          <button class="btn btn-danger" type="submit">Excluir pet</button>
        </form>
      </section>
      <% } %>
    </div>
  </div>
</section>
<%- include('../common/footer') %>
