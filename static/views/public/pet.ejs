<%- include('../common/head', { title }) %>
<%
  const speciesPt = ['Perro','Cachorro'].includes(pet.species) ? 'Cão' : (['Otra','Otro'].includes(pet.species) ? 'Outro' : pet.species);
  const sexPt = pet.sex === 'Hembra' ? 'Fêmea' : pet.sex;
%>
<section class="page">
  <div class="container grid grid-2">
    <section class="card">
      <div class="pet-profile">
        <% if (pet.photo_url) { %>
        <img class="pet-avatar" src="<%= pet.photo_url %>" alt="Foto de <%= pet.name %>" loading="eager" referrerpolicy="no-referrer">
        <% } else { %>
        <div class="pet-avatar" style="display:grid;place-items:center;font-size:48px">🐾</div>
        <% } %>
        <div style="margin-left:-5px;">
          <span class="status <%= pet.is_lost ? 'status-lost' : 'status-ok' %>"><%= pet.is_lost ? 'PET PERDIDO' : 'Pet seguro' %></span>
          <h1 class="pet-name" style="margin:5px 0 0;"><%= pet.name %></h1>
          <div class="muted"><%= [pet.breed, speciesPt, sexPt].filter(Boolean).join(' · ') %></div>
        </div>
      </div>
      <div class="info-list">
        <div class="info-row">
            <span>Cor</span>
            <strong>
                <%= pet.color?.trim()
                    ? pet.color
                    : 'Cor não informada.' %>
            </strong>
        </div>
        <div class="info-row">
            <span>Informações médicas</span>
            <strong>
                <%= pet.medical_conditions?.trim()
                    ? pet.medical_conditions
                    : 'Nenhuma condição médica importante informada.' %>
            </strong>
        </div>
        <div class="info-row">
            <span>Observação</span>
            <strong>
                <%= pet.notes?.trim()
                    ? pet.notes
                    : 'Nenhuma observação adicional informada.' %>
            </strong>
        </div>
      </div>
    </section>
    <aside class="card">
      <h2><%= pet.is_lost ? `🚨 ${pet.name} está perdido` : `Encontrou ${pet.name}?` %></h2>
      <p class="muted">Você pode entrar em contato diretamente com a família. Não é necessário instalar nenhum aplicativo.</p>
      <div class="actions">
        <% const wa = (pet.whatsapp || pet.phone || '').replace(/\D/g,''); %>
        <% if (wa) { %>
        <a class="btn btn-success" href="https://wa.me/<%= wa %>" target="_blank" rel="noopener">💬 WhatsApp</a>
        <% } %>
        <% if (pet.phone) { %>
        <a class="btn btn-primary" href="tel:<%= pet.phone %>">📞 Ligar</a>
        <% } %>
      </div>
      <% if (pet.contact_name) { %>
      <div style="margin-top:24px;padding:16px;background:var(--surface2);border-radius:16px">
        <strong>Contato principal</strong>
        <div class="muted" style="margin-top:4px"><%= pet.contact_name %><%= pet.relationship ? ` · ${pet.relationship}` : '' %></div>
      </div>
      <% } %>
    </aside>
  </div>
</section>
<%- include('../common/footer') %>
