<%- include('../common/head', { title }) %>

<section class="page">
  <div class="container grid grid-2">

    <section class="card hero-card">
      <span class="eyebrow">Identificação PetID</span>
      <h1 id="previewTitle">Nova plaquinha</h1>
      <p class="lead" id="previewDescription">
        O PetID já gerou o código único desta identificação.
      </p>

      <div class="tag-preview" style="margin-top:28px">
        <div>
          <div style="font-size:38px">NFC</div>
          <strong id="previewCode"><%= newTag.public_code %></strong>
          <small id="previewLabel">Nova identificação</small>
        </div>
      </div>

      <div id="replacementPreview" style="display:none;margin-top:22px;padding:16px;background:#fff7ed;border-radius:16px;color:#9a3412">
        <strong>Plaquinha atual</strong>
        <div style="margin-top:6px">
          Código: <strong id="oldCodeText"></strong>
        </div>
        <div style="margin-top:8px;font-size:.9rem">
          Ao confirmar, esta identificação será desativada e substituída pela nova.
        </div>
      </div>

      <div style="margin-top:24px;padding:16px;background:rgba(255,255,255,.75);border-radius:16px">
        <strong>Nova URL NFC/QR Code</strong>
        <div class="muted" style="margin-top:8px;word-break:break-all">
          <%= data.baseUrl %>/p/<%= newTag.public_code %>
        </div>
      </div>
    </section>

    <section class="card">
      <% if (error) { %>
        <div class="flash flash-error"><%= error %></div>
      <% } %>

      <% if (!pets.length) { %>
        <h2>Primeiro cadastre um pet</h2>
        <p class="muted">É necessário ter um perfil antes de vincular uma plaquinha.</p>
        <a class="btn btn-primary" href="/pets/new">Cadastrar pet</a>
      <% } else { %>

        <h2>Para qual pet é esta plaquinha?</h2>
        <p class="muted">
          Selecione o pet. Se ele já tiver uma identificação ativa, o PetID fará a substituição da plaquinha.
        </p>

        <form method="post" action="/tags/activate" id="activateTagForm">
          <div class="field">
            <label for="pet_id">Pet</label>
            <select name="pet_id" id="pet_id" required>
              <option value="">Selecione...</option>

              <% pets.forEach(p => { %>
                <option
                  value="<%= p.id %>"
                  data-has-tag="<%= p.activeTag ? '1' : '0' %>"
                  data-public-code="<%= p.activeTag?.public_code || '' %>"
                  data-pet-name="<%= p.name %>"
                  <%= String(selectedPetId || '') === String(p.id) ? 'selected' : '' %>
                >
                  <%= p.name %> — <%= p.activeTag ? 'plaquinha ativa' : 'sem plaquinha' %>
                </option>
              <% }) %>
            </select>
          </div>

          <div id="tagStatusBox" style="display:none;margin-top:14px;padding:16px;border-radius:16px"></div>

          <div class="field" style="margin-top:18px">
            <label for="new_public_code">Código da nova plaquinha</label>
            <input
              id="new_public_code"
              type="text"
              value="<%= newTag.public_code %>"
              readonly
              tabindex="-1"
              aria-readonly="true"
              style="text-transform:uppercase;letter-spacing:.18em;font-weight:800;background:#f8fafc;cursor:not-allowed"
            >
            <div class="helper">
              Gerado automaticamente pelo PetID. Este código não pode ser editado.
            </div>
          </div>

          <div class="field" style="margin-top:18px">
            <label>Endereço que será gravado no NFC/QR Code</label>
            <input
              type="text"
              value="<%= data.baseUrl %>/p/<%= newTag.public_code %>"
              readonly
              tabindex="-1"
              aria-readonly="true"
              style="background:#f8fafc;cursor:not-allowed"
            >
          </div>

          <button id="activateButton" class="btn btn-primary" style="width:100%;margin-top:18px">
            Ativar plaquinha
          </button>
        </form>
      <% } %>
    </section>

  </div>
</section>

<script>
(function () {
  const select = document.getElementById('pet_id');
  const box = document.getElementById('tagStatusBox');
  const button = document.getElementById('activateButton');
  const previewTitle = document.getElementById('previewTitle');
  const previewDescription = document.getElementById('previewDescription');
  const previewCode = document.getElementById('previewCode');
  const previewLabel = document.getElementById('previewLabel');
  const replacementPreview = document.getElementById('replacementPreview');
  const oldCodeText = document.getElementById('oldCodeText');
  const newCode = <%- JSON.stringify(newTag.public_code) %>;

  if (!select || !box || !button) return;

  function refreshState() {
    const option = select.options[select.selectedIndex];

    if (!option || !option.value) {
      box.style.display = 'none';
      replacementPreview.style.display = 'none';
      previewTitle.textContent = 'Nova plaquinha';
      previewDescription.textContent = 'O PetID já gerou o código único desta identificação.';
      previewCode.textContent = newCode;
      previewLabel.textContent = 'Nova identificação';
      button.textContent = 'Ativar plaquinha';
      button.className = 'btn btn-primary';
      button.style.width = '100%';
      button.style.marginTop = '18px';
      return;
    }

    const hasTag = option.dataset.hasTag === '1';
    const oldCode = option.dataset.publicCode || '';
    const petName = option.dataset.petName || 'este pet';

    box.style.display = 'block';

    if (hasTag) {
      box.style.background = '#fff7ed';
      box.style.color = '#9a3412';
      box.innerHTML = `
        <strong>${petName} já tem uma plaquinha ativa.</strong>
        <div style="margin-top:5px">
          Ao confirmar, a plaquinha anterior será desativada e o novo código será ativado <strong>${newCode}</strong>.
        </div>`;

      replacementPreview.style.display = 'block';
      oldCodeText.textContent = oldCode;

      // Na substituição, o cartão à esquerda mostra a identificação atual.
      previewTitle.textContent = `Plaquinha atual de ${petName}`;
      previewDescription.textContent = 'Esta é a identificação que será substituída ao confirmar a troca.';
      previewCode.textContent = oldCode || '—';
      previewLabel.textContent = 'Identificação atual';

      button.textContent = 'Substituir plaquinha';
      button.className = 'btn btn-warning';
    } else {
      box.style.background = '#d1fae5';
      box.style.color = '#047857';
      box.innerHTML = `
        <strong>${petName} ainda não tem uma plaquinha ativa.</strong>
        <div style="margin-top:5px">O código <strong>${newCode}</strong> será vinculado ao perfil.</div>`;

      replacementPreview.style.display = 'none';
      oldCodeText.textContent = '';

      previewTitle.textContent = `Nova plaquinha para ${petName}`;
      previewDescription.textContent = 'Esta será a primeira identificação digital PetID deste pet.';
      previewCode.textContent = newCode;
      previewLabel.textContent = 'Nova identificação';

      button.textContent = 'Ativar plaquinha';
      button.className = 'btn btn-primary';
    }

    button.style.width = '100%';
    button.style.marginTop = '18px';
  }

  select.addEventListener('change', refreshState);
  refreshState();
})();
</script>

<%- include('../common/footer') %>
